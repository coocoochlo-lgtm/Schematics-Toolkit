<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Schematics collaboration helper: LAN discovery, the live session (host election, fan-out, shared store, host
    migration) and git automation, kept outside Unity so it survives script reloads and editor freezes.
    Started by the editor (Schematics/Editor/Collaboration/Core/CollabHelper.cs); see ../README.md.
    No NuGet packages, so building needs no downloads.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>SchematicsCollab</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The wire protocol, shared word for word with Unity (it lives in the runtime assembly, so builds speak it too). -->
    <Compile Include="../../Schematics/Runtime/Collaboration/CollabProtocol.cs" Link="Protocol/CollabProtocol.cs" />
    <!-- The playtest client that runs inside builds (pure C#), so the self test can join a session the way a build does. -->
    <Compile Include="../../Schematics/Runtime/Collaboration/CollabRuntimeClient.cs" Link="Protocol/CollabRuntimeClient.cs" />
    <Compile Include="../../Schematics/Runtime/Collaboration/CollabLiveEditCodec.cs" Link="Protocol/CollabLiveEditCodec.cs" />
  </ItemGroup>
</Project>
