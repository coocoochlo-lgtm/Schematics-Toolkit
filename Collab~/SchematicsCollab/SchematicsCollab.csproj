<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Schematics collaboration helper: LAN discovery, the live session (host election, fan-out, shared store, host
    migration) and git automation, kept outside Unity so it survives script reloads and editor freezes.
    Started by the editor (Schematics/Editor/Collaboration/Core/CollabHelper.cs); see ../README.md.
    No NuGet packages, so building needs no downloads.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>SchematicsCollab</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The wire protocol, shared word for word with the Unity editor bridge. -->
    <Compile Include="../../Schematics/Editor/Collaboration/Core/CollabProtocol.cs" Link="Protocol/CollabProtocol.cs" />
  </ItemGroup>
</Project>
