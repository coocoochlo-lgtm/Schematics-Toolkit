// Records each head's position into its tail ring after every brain tick (works the same for GPU and CPU brains:
// both expose head positions as a GPU buffer).
#pragma kernel Record

StructuredBuffer<float> _Heads;     // row r's heads at r × _HeadStride
RWStructuredBuffer<float> _Tails;   // (row × H + h) × _TailLength × D
uint _Rows, _H, _D, _HeadStride, _TailLength, _TailHead;

[numthreads(64, 1, 1)]
void Record(uint3 id : SV_DispatchThreadID)
{
    uint thread = id.x;
    if (thread >= _Rows * _H)
        return;
    uint row = thread / _H, head = thread % _H;
    uint to = ((row * _H + head) * _TailLength + _TailHead) * _D;
    uint from = row * _HeadStride + head * _D;
    for (uint d = 0; d < _D; d++)
        _Tails[to + d] = _Heads[from + d];
}
