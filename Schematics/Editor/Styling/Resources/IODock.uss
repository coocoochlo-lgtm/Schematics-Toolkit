/* Main Window */
.canvasViewTitle
{
	color: #8899ff !important;
}

.canvas-overlay
{
	background-image: url("Textures/canvas-gradient.png");
}

.iodock 
{
	background-color: #010101;
	background-image: url("Textures/io-gradient.png");
}


/* --- Sidebar and Content --- */
.schematic-snc-sidebar
{
    width: 300px;
    min-height : 100%;
    background-color : #080809;
}

.schematic-snc-divider
{
    background-color : #3377aa;
	background-image: url("Textures/io-gradient.png");
}

.schematic-snc-divider-hover
{
    background-color : #676767;
}


/* --- Lists --- */
LazyFoldout
{
	border-color: gray;
	overflow: hidden;
	border-right-width: 0px;
}

LazyListFoldout
{
    background-color: #151515;
	background-image: url("Textures/list-gradient.png");

	border-color: black;

	border-right-width: 0px;
}

.list-content
{
	margin-right: 8px;
	border-color: rgba(1,1,1,0.25);
	border-width: 1px;
	padding-bottom: 8px;
}

.list-item-header
{
	padding: 4px;
}

.list-item-content
{
	margin-left: 0px;
	border-color: rgba(255,255,255,0.2);
	overflow:hidden;
	padding: 1px;
}

.list-customizationbar
{
	background-image: url("Textures/customization-bar-gradient.png");
	padding: 4px;
	padding-right: 0px;
}

.list-button-add
{
	background-color: #777799;
	background-image: url("Textures/button-gradient.png");
}

.list-button-add-hover
{
	background-color: #aaaacc;
	background-image: url("Textures/button-gradient.png");
}

.list-button-remove
{
	background-color: #a00000;
	background-image: url("Textures/button-gradient.png");
	position: absolute;
	top: -1px;
	right: 0px;
	width: 16px;
	height: 16px;
}

.list-button-remove-hover
{
	background-color: #ff0000;
	background-image: url("Textures/button-gradient.png");
}

.list-header
{
	background-image: url("Textures/list-label-gradient.png");
}

.list-toggle VisualElement
{
	margin-left: 0px;
}

.list-label
{
	padding-right: 14px;
}

.list-toggle
{
	margin: 0px;
	margin-right: 4px;
	border-top-width: 1px;
	border-left-width: 1px;
	border-color: rgba(255,255,255,0.2);
}

.list-toggle #unity-checkmark
{
	background-image: url("Textures/list-foldout-toggle.png");
	background-size: 100% 100%;

	margin-right: 0px;

	-unity-slice-left : 0;
	-unity-slice-top : 0;

	max-width: 16px;
	max-height: 16px;
}

LazyFoldout Toggle
{
	margin: 0px;
}

LazyFoldout #unity-checkmark
{
	background-image: url("Textures/list-foldout-toggle-2.png");
	background-size: 100% 100%;
	-unity-slice-left : 0;
	-unity-slice-top : 0;
	margin-right: 0px;

	max-width: 16px;
	max-height: 16px;
}


.list-toggle-container
{
	margin-left: 0px;
	margin-right: 0px;
	background-image: url("Textures/list-header-gradient.png");
	padding:4px;
}


.list-item-0
{
    background-color: #494949;
	background-image: url("Textures/list-gradient.png");
}

.list-item-1
{
    background-color: #797979;
	background-image: url("Textures/list-gradient.png");
}

.list-container-1-0
{
    background-color: #222222;
	background-image: url("Textures/list-gradient.png");
}

.list-container-1-1
{
    background-color: #323232;
	background-image: url("Textures/list-gradient.png");
}

.child-header
{
	background-image: url("Textures/list-header-gradient.png");
}

.list-header
{
	width: 100%;
	padding: 0px;
}

.list-customizationbar-game-object
{
	height: 0px;
	padding: 0px;
}

.list-customizationbar-game-object
{
	height: 0px;
	padding: 0px;
}

.list-button-game-object-add
{
	position:absolute; 
	top: 0px;
	right: 0px;
	width: 16px;
	height: 16px;
}

.list-container-game-object
{
    background-color: #252525;
	border-width: 0px;
}

.list-content-game-object
{
	margin-right: 0px;
	border-right-width: 0px;
	border-top-width: 0px;
	border-bottom-width: 0px;
	padding:0px;
	border-top-color: black;
}
.list-item-game-object
{
	border-width: 0px;
	padding: 0px;
	background-color: #171737;
}
.list-toggle-game-object
{
	margin-right:0px;
}

.child-header
{
	background-color: #373737;
}


/* --- TabView --- */
.scope-tab-scrollbar
{
	background-color: #212121;
	background-image: url("Textures/list-gradient.png");
}
.scope-tab
{
	background-color: #676767;
	background-image: url("Textures/list-gradient.png");
}
.scope-tab-selected
{
	background-color: #000000;
	background-image: url("Textures/list-gradient.png");
	
	border-top-color: #3377aa;
	border-left-color: #3377aa;
	border-right-color: #3377aa;
}

.scope-tab-label
{
	color: #8899a0;
	font-size: 16px;
	max-width: 50%;
}

.components-tab-scrollbar
{
}

.components-tabbar
{
	background-color: rgba(0,0,0,0.2);
}

.components-tab-content
{
	background-color: #000000;
	padding: 4px;
	padding-right: 0px;
}

.components-tab
{
	padding: 4px;
	background-color: #474747;
}

.components-tab-selected
{
	background-color: #000000;
	height: 110%;
}

.component-foldout
{
	margin: 2px;
	margin-left: 8px;
	background-color: rgba(0,0,0,0.2);
	border-width: 1px;
	
	border-color: rgba(0,0,0,0.2);
	background-image:url("Textures/canvas-gradient.png");
	
	margin-bottom: 8px;
}

.component-foldout TabView
{
	margin-left: 0px;
	margin: 4px;
}



/* --- Event container --- */
EventContainerRenderer
{
	border-width: 2px;
	border-color: rgba(0,0,0,0.5);
	background-color: rgba(255,255,255,0.25);
}

.event-container
{
	background-image: url("Textures/title-gradient.png");
	padding: 4px;
	border-radius: 4px;
	overflow: hidden;
}

.event-container-input
{
	background-color: rgba(0,0,75,0.25);
}
.event-container-output
{
	background-color: rgba(75,0,0,0.25);
}


.event-type-dropdown
{
	background-color: rgba(0,0,0,0.25);
}

.event-name
{
	background-color: rgba(0,0,0,0.1);
	margin-bottom: 4px;
}

.even-link-label
{
	color: blue;
}

.event-name-hover
{
	background-color: rgba(0,0,0,0.65);
}

.event-parameter-container
{
	background-image: url("Textures/title-gradient.png");
	opacity: 0.8;
}

.event-parameter-container-hover
{
	background-image: url("Textures/title-gradient.png");
	opacity: 1;
}

.list-toggle-event-parameters
{
	background-color: rgba(0,0,0,0.1);
	background-image: none;
	margin-right: 0px;
	color: #aaa;
}
.list-toggle-event-parameters VisualElement
{
	background-image: none;
}


.list-customizationbar-event-parameters
{
	display: none;
}
.list-content-event-parameters
{
	padding-bottom:0px;
	border-bottom:0px;
	border-top:0px;
	padding: 2px;
	background-color: rgba(0,0,0,0.25);
	padding: 4px;
}
.list-item-event-parameters
{
	padding-bottom:0px;
	padding-top: 0px;
	border-bottom:0px;
	border-top:0px;
	border-radius:8px;
	background-color: rgba(0,0,0,1);
}

.list-item-event-parameters PopupField
{
	border-radius:8px;
}
.list-item-event-parameters TextField
{
	border-radius:8px;
}


.list-content-event-parameters
{
	margin-right: 0px;
	border-width: 0px;
	border-radius: 8px;
}
.list-container-event-parameters
{
	border-top:0px;
	background-image: none;
	background-color: rgba(0,0,0,0);
}

	
/* --- Every node: a thin border in the node's colour (set by NodeLook), and its title (on its own colour bar, as
   before) centred, wrapping rather than spilling out. The Signal and Variable nodes' own rules below build on this. --- */
.nodeView #node-border
{
	border-width: 1px;
	border-color: rgba(200,200,200,0.6);
}

.nodeView #node-border #title
{
	height: auto;
	min-height: 30px;
	padding: 4px 10px;
	justify-content: center;
	align-items: center;
}

.nodeView #node-border #title #title-label
{
	-unity-text-align: middle-center;
	white-space: normal;
	flex-grow: 1;
	flex-shrink: 1;
	margin: 0;
	-unity-font-style: bold;
}

/* --- Nodes --- */
.node-On-Signal-Received
{
	width: 160px;
	height: 96px;
	border-width: 0px;
	background-image: url("Textures/signal-mark-in.png");
	-unity-background-image-tint-color: rgb(255, 97, 90);
	background-size: 40px 40px;
	background-position: 12px 12px;
}

.node-On-Signal-Received VisualElement
{
	overflow: visible;
	border-width: 0px;
}

.node-On-Signal-Received #node-border 
{
	opacity: 1;
	height: 96px;
	border-width: 1px;
	border-color: rgba(255,155,155,0.75);
	background-color: rgba(255,255,255,0.2);
	background-image: url("Textures/io-graph-gradient.png");

}

.node-On-Signal-Received #node-border #title
{
	opacity: 0;
}

.node-On-Signal-Received #node-border #output
{
	position:absolute;
	top:-20px;
	right: 0px;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	align-items: stretch;
}

.node-On-Signal-Received #node-border #contents #top #output 
{
	opacity: 1;
	background-image: none;
	background-color: rgba(0,0,0,0);
}


.node-On-Signal-Received #node-border #contents #top #output PortView
{
	opacity: 1;
	background-image: none;
	background-color: rgba(0,0,0,0);
	margin-left: 16px;
}

.node-On-Signal-Received #node-border VisualElement
{
	opacity: 1;
	background-image: none;
	background-color: rgba(0,0,0,0);
	overflow: visible;
}

.node-On-Signal-Received #node-border #divider
{
	display:none;
}

.node-On-Signal-Received #node-border #collapsible-area
{
	position:absolute;
	width:100%;
	height:100%;
}
.node-On-Signal-Received #node-border #extension
{
	position:absolute;
	width:100%;
	height:24px;
	bottom: 4px;
}

.node-On-Signal-Received #node-border ObjectField Label
{
	display:none;
}

.node-On-Signal-Received #node-border ObjectFieldDisplay Label
{
	display:flex;
    -unity-font-style: bold;
}
.node-On-Signal-Received #node-border ObjectField 
{
	position:absolute;
	width:100%;
	height: 100%;
}
.node-On-Signal-Received #node-border ObjectField VisualElement
{
	position:absolute;
	width:134px;
	background-image:url("Textures/io-gradient.png");
	border-width:1px;
	border-color:gray;
}

.node-On-Signal-Received #node-border ObjectField
{
}

.node-On-Signal-Received #node-border ObjectField ObjectFieldSelector
{
	display: none;
}

.node-On-Signal-Received #collapsible-area
{
	opacity: 1;
	background-image: none;
	background-color: rgba(0,0,0,0);
}

.node-On-Signal-Received #collapsible-area VisualElement
{
	opacity: 1;
	background-image: none;
	background-color: rgba(0,0,0,0);
}

.node-Send-a-Signal
{
	width: 160px;
	height: 96px;
	border-width: 0px;
	background-image: url("Textures/signal-mark.png");
	-unity-background-image-tint-color: rgb(97, 158, 255);
	background-size: 40px 40px;
	/* (At the right: it's going out.) */
	background-position: 108px 12px;
}

.node-Send-a-Signal VisualElement
{
	overflow: visible;
	border-width: 0px;
}

.node-Send-a-Signal #node-border
{
	opacity: 1;
	height: 96px;
	border-width: 1px;
	border-color: rgba(155,155,255,0.75);
	background-color: rgba(45,105,255,0.35);
	background-image: url("Textures/io-graph-gradient.png");
}

.node-Send-a-Signal #node-border #title
{
	opacity: 0;
}

.node-Send-a-Signal #node-border #input
{
	position: absolute;
	top: -20px;
	left: 0px;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	align-items: stretch;
	background-image: none;
	background-color: rgba(0,0,0,0);
}

.node-Send-a-Signal #node-border #contents #top #input
{
	opacity: 1;
	background-image: none;
	background-color: rgba(0,0,0,0);
}

.node-Send-a-Signal #node-border #contents #top #input PortView
{
	opacity: 1;
	background-image: none;
	background-color: rgba(0,0,0,0);
	margin-right: 16px;
}

.node-Send-a-Signal #node-border VisualElement
{
	opacity: 1;
	background-image: none;
	background-color: rgba(0,0,0,0);
	overflow: visible;
}

.node-Send-a-Signal #node-border #divider
{
	display: none;
}

.node-Send-a-Signal #node-border #collapsible-area
{
	position: absolute;
	width: 100%;
	height: 100%;
}

.node-Send-a-Signal #node-border #extension
{
	position: absolute;
	width: 100%;
	height: 24px;
	bottom: 4px;
}

.node-Send-a-Signal #node-border ObjectField Label
{
	display: none;
}

.node-Send-a-Signal #node-border ObjectFieldDisplay Label
{
	display: flex;
	-unity-font-style: bold;
}

.node-Send-a-Signal #node-border ObjectField
{
	position: absolute;
	width: 100%;
	height: 100%;
}

.node-Send-a-Signal #node-border ObjectField VisualElement
{
	position: absolute;
	width: 134px;
	background-image: url("Textures/io-gradient.png");
	border-width: 1px;
	border-color: gray;
}

.node-Send-a-Signal #node-border ObjectField ObjectFieldSelector
{
	display: none;
}

.node-Send-a-Signal #node-border #collapsible-area
{
	position: absolute;
	width: 100%;
	height: 100%;
}

.node-Send-a-Signal #collapsible-area
{
	opacity: 1;
	background-image: none;
	background-color: rgba(0,0,0,0);
}

.node-Send-a-Signal #collapsible-area VisualElement
{
	opacity: 1;
	background-image: none;
	background-color: rgba(0,0,0,0);
}

Button
{
	padding: 2px;
}

TextElement
{
	margin-left: 0px;
}

.-tab-selected
{
	background-color: black;
}

/* ---- Behavior dock (Prefab tab) ---- */
.event-container-variable
{
	background-color: rgba(0,60,45,0.25);
}
.dock-row
{
	margin: 1px 4px 1px 8px;
	min-height: 20px;
}
.dock-row:hover
{
	background-color: rgba(255,255,255,0.06);
}
.dock-row .event-name
{
	margin-bottom: 0;
	padding: 0 4px;
}
.dock-row-detail
{
	font-size: 10px;
	padding-right: 4px;
}
.dock-section-label
{
	font-size: 10px;
	margin-left: 8px;
	opacity: 0.8;
}
.dock-behavior
{
	margin: 2px 0 4px 4px;
	padding-bottom: 2px;
	border-left-width: 2px;
	border-left-color: rgba(120,160,255,0.35);
}
.dock-object > Toggle
{
	background-color: rgba(0,0,0,0.2);
}
.dock-drag-handle
{
	opacity: 0.75;
}
.dock-drag-handle:hover
{
	opacity: 1;
}
.dock-add-behavior
{
	margin: 2px 8px 6px 8px;
}

.dock-row-handle
{
	max-width: 55%;
}
.dock-variable-value
{
	margin-left: 4px;
}
.dock-properties
{
	margin: 4px 4px 2px 8px;
}

/* ---- Tab rows that fold like dropdowns: Behaviors > sections (Variables, Signals, Properties) > Properties headers ---- */
.component-tabs
{
	margin: 2px;
	margin-left: 8px;
}

.components-tab-action
{
	padding: 2px 6px;
	background-color: #3a3a3a;
	-unity-font-style: bold;
}

.tab-add-component
{
	margin-left: 6px;
}

.dock-behavior-name
{
	-unity-font-style: bold;
	color: #b0b0b0;
	margin-bottom: 2px;
}

.sections-tabbar
{
	background-color: rgba(0,0,0,0.25);
}

.sections-tab
{
	padding: 3px 6px;
	background-color: #3c3c3c;
}

.sections-tab-hover, .components-tab-hover, .headers-tab-hover
{
	background-color: #505050;
}

.sections-tab-selected
{
	background-color: #1e3a52;
}

.sections-tab-label
{
	color: #8899a0;
	-unity-font-style: bold;
	margin-right: 4px;
}

.sections-tab-content
{
	padding: 4px 0px 2px 0px;
}

.headers-tab
{
	padding: 2px 6px;
	background-color: #343434;
	font-size: 11px;
}

.headers-tab-selected
{
	background-color: #2a2a2a;
	border-bottom-width: 2px;
	border-bottom-color: #3377aa;
}

.headers-tab-content
{
	padding-top: 4px;
}

/* The object selected in the scene (or Prefab Mode, or the Project window). */
.dock-object-selected
{
	background-color: rgba(44, 93, 135, 0.85);
	border-top-left-radius: 3px;
	border-top-right-radius: 3px;
	border-bottom-left-radius: 3px;
	border-bottom-right-radius: 3px;
}

/* Signals' rows, as tight as the Variables' (Behavior dock). */
.dock-signal
{
	margin: 1px 4px 1px 8px;
	padding: 2px 4px;
	border-radius: 4px;
	border-width: 0px;
}
.dock-signal .event-name
{
	margin-bottom: 0;
	padding: 0 4px;
	border-radius: 2px;
}
.dock-signal TextField
{
	margin: 0;
}
.dock-signal Toggle
{
	margin: 0 2px;
}

/* Foldout arrows turn when opened (LazyFoldout sets the angle). */
.list-toggle #unity-checkmark, LazyFoldout #unity-checkmark
{
	transition-property: rotate;
	transition-duration: 0.12s;
}

/* Signal and Variable names, equally bright. */
.dock-signal .event-name, .dock-signal .event-name TextElement, .dock-row .event-name, .dock-row-name
{
	color: #e6e6e6;
}
.dock-signal-mark
{
	margin-left: 2px;
}

/* Signals' rows on the Variables' background (their bar and triangle tell received from sent). */
.dock-signal.event-container-input, .dock-signal.event-container-output,
.dock-row-signal.event-container-input, .dock-row-signal.event-container-output
{
	background-color: rgba(0,60,45,0.25);
}

/* --- Variable nodes: the Signal nodes' look, with the Variable's ring (tinted with its type's colour, along with the
   border, by NodeLook) and its title kept, as that's its name. --- */
.node-Get-Variable, .node-Set-Variable, .node-Get-Graph-Variable, .node-Set-Graph-Variable
{
	min-width: 160px;
	border-width: 0px;
}

.node-Get-Variable #node-border, .node-Set-Variable #node-border,
.node-Get-Graph-Variable #node-border, .node-Set-Graph-Variable #node-border
{
	opacity: 1;
	border-width: 1px;
	border-color: rgba(200,200,200,0.75);
	background-color: rgba(255,255,255,0.12);
	background-image: url("Textures/io-graph-gradient.png");
}

.node-Get-Variable #node-border #title, .node-Set-Variable #node-border #title,
.node-Get-Graph-Variable #node-border #title, .node-Set-Graph-Variable #node-border #title
{
	background-image: none;
	background-color: rgba(0,0,0,0);
	min-height: 32px;
}

/* The bar and ring beside the name, as in the IO Dock's Variable rows (NodeLook puts them there). */
.nodeView #title .node-variable-mark
{
	flex-direction: row;
	align-items: center;
	flex-shrink: 0;
	margin-right: 4px;
}
.node-Get-Variable #node-border #title #title-label, .node-Set-Variable #node-border #title #title-label,
.node-Get-Graph-Variable #node-border #title #title-label, .node-Set-Graph-Variable #node-border #title #title-label
{
	flex-grow: 0;
}

/* A Signal's parameters: dots in their types' colours under its name, each stretching out into a pill holding
   "name: type" while hovered (SignalParameterList sets the sizes; these animate them). */
.dock-signal-params
{
	margin: 1px 0 1px 32px;
}
.dock-signal-param-pill
{
	transition-property: max-width, height;
	transition-duration: 0.14s;
	transition-timing-function: ease-out;
}
.dock-signal-param-name
{
	-unity-font-style: bold;
	font-size: 10px;
	margin: 0;
	padding: 0 2px 0 6px;
	white-space: nowrap;
	transition-property: opacity;
	transition-duration: 0.12s;
}
.dock-signal-param-type
{
	font-size: 10px;
	margin: 0;
	padding: 0 6px 0 0;
	white-space: nowrap;
	transition-property: opacity;
	transition-duration: 0.12s;
}
.dock-signal-param-add
{
	color: #9a9a9a;
	-unity-font-style: bold;
	font-size: 11px;
	margin: 0 0 0 2px;
	padding: 0 3px;
}
.dock-signal-param-add:hover
{
	color: #e6e6e6;
}

/* ---- Lists and foldouts (the Global tab's Input Maps and Inputs, and the like), in the tabs' and rows' flat, tight
   look: no gradient boxes, a thin guide line for each level, quiet buttons that light up on hover. ---- */
LazyListFoldout
{
	background-color: rgba(0,0,0,0);
	background-image: none;
	border-width: 0px;
	border-left-width: 1px;
	border-left-color: rgba(255,255,255,0.08);
	margin: 1px 0 1px 4px;
}

.list-content
{
	margin-right: 0px;
	border-width: 0px;
	padding: 0 0 2px 8px;
}

.list-toggle-container
{
	background-image: none;
	background-color: rgba(255,255,255,0.045);
	border-top-left-radius: 3px;
	border-top-right-radius: 3px;
	border-bottom-left-radius: 3px;
	border-bottom-right-radius: 3px;
	padding: 2px 4px;
	margin: 1px 0;
}

.list-toggle-container:hover
{
	background-color: rgba(255,255,255,0.08);
}

.list-header, .child-header
{
	background-image: none;
}

.list-label
{
	color: #d8d8d8;
	padding-right: 18px;
}

.list-customizationbar
{
	background-image: none;
	padding: 0;
}

.list-item-0, .list-item-1, .list-container-1-0, .list-container-1-1
{
	background-color: rgba(0,0,0,0);
	background-image: none;
}

.list-item-content
{
	padding: 0;
}

.list-button-add, .list-button-remove
{
	background-image: none;
	background-color: rgba(0,0,0,0);
	border-width: 0px;
	color: #8f8f8f;
	-unity-font-style: bold;
	width: 16px;
	height: 16px;
	padding: 0;
	margin: 0 0 0 2px;
	border-top-left-radius: 3px;
	border-top-right-radius: 3px;
	border-bottom-left-radius: 3px;
	border-bottom-right-radius: 3px;
}

.list-button-add-hover
{
	background-image: none;
	background-color: rgba(255,255,255,0.12);
	color: #ffffff;
}

.list-button-remove-hover
{
	background-image: none;
	background-color: rgba(255,80,80,0.25);
	color: #ff9090;
}

/* (The object hierarchy keeps its own colours.) */
.list-item-game-object
{
	background-color: #171737;
}
.list-container-game-object
{
	background-color: #252525;
}

/* Globals and Input Maps as tabs; a flat list's "add" button. */
.globals-tab, .maps-tab
{
	padding: 3px 8px;
	background-color: #343434;
}
.globals-tab-hover, .maps-tab-hover
{
	background-color: #505050;
}
.globals-tab-selected, .maps-tab-selected
{
	background-color: #1e3a52;
}
.globals-tab-content, .maps-tab-content
{
	padding-top: 4px;
}
.identity-list-add
{
	align-self: flex-start;
	margin: 3px 0 2px 4px;
	padding: 1px 8px;
	font-size: 11px;
	background-image: none;
	background-color: rgba(255,255,255,0.06);
	border-width: 0px;
	color: #a8a8a8;
}
.identity-list-add:hover
{
	background-color: rgba(255,255,255,0.12);
	color: #ffffff;
}
