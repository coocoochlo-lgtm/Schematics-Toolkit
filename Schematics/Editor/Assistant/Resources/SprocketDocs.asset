%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4d818f718da48ffa144b0840be6b570, type: 3}
  m_Name: SprocketDocs
  m_EditorClassIdentifier: Remedy.Schematics.Editor::Remedy.Schematics.Assistant.SprocketDocs
  Entries:
  - Key: behavior:CharacterMotionContext
    Title: Character Motion Context
    Summary: "Applies forces, springs and gravity to a character's Box3D body. Movement controllers on the same GameObject drive it\r through its methods (on the selected instance): Self.GetSchematicBehavior<CharacterMotionContext>().ApplyForce(...)."
    Description: 
  - Key: behavior:CharacterRaycastContext
    Title: Character Raycast Context
    Summary: Ground and wall detection for a character, shared by the Motion Context and the movement controllers.
    Description: 
  - Key: behavior:PhysicsBasedCharacterController
    Title: Physics Based Character Controller
    Summary: "Physics based character movement: rides at a hover height above the ground, jumps with a buffer and hang time,\r and falls with extra gravity. Movement itself is applied through the Character Motion Context and ground\r detection comes from the Character Raycast Context; both are attached along with it.\r Input arrives through the Motion Context's MoveInput and JumpInput Signals."
    Description: 
  - Key: behavior:Remedy.Animation.AnimationComunicator
    Title: Animation Comunicator
    Summary: "Drives the Animator on its GameObject from Signals: each entry of its Properties maps a Signal to an Animator\r parameter (trigger, bool, float, or a Vector2 split into floats)."
    Description: 
  - Key: behavior:Remedy.Audio.SoundCue
    Title: Sound Cue
    Summary: "Plays an Audio Definition list from the Audio Data, on start, on collision/trigger, or when its Signal is sent.\r Play and Stop act on the selected instance."
    Description: 
  - Key: behavior:Remedy.Cameras.CameraPropertiesVolume
    Title: Camera Properties Volume
    Summary: "A trigger volume that changes camera settings for Camera Operators inside it.\r Operators read the values with the volume's instance, e.g. volume.Zoom[volumeInstance]."
    Description: 
  - Key: behavior:Remedy.Cameras.ShoulderCamera
    Title: Shoulder Camera
    Summary: The Shoulder Camera Behavior.
    Description: 
  - Key: behavior:Remedy.Cameras.ThirdPersonCamera
    Title: Third Person Camera
    Summary: The Third Person Camera Behavior.
    Description: 
  - Key: behavior:Remedy.CharacterControllers.CharacterControllerRig
    Title: Character Controller Rig
    Summary: "Makes the character's renderer follow its physics body smoothly: tilting, turning, squashing with vertical speed,\r and posing for whichever movement controller is enabled (Wall Slide, Hover, Ledge Grab, or the default)."
    Description: 
  - Key: behavior:Remedy.CharacterControllers.Gadgets.Pusher
    Title: Pusher
    Summary: Launches Rigidbodies that touch it along its up axis, after a short delay, squashing while it does.
    Description: 
  - Key: behavior:Remedy.CharacterControllers.Hover.HoverController
    Title: Hover Controller
    Summary: 'Flight: rises while there''s Stamina, then hovers and plummets. Input comes from the Motion Context''s Signals.'
    Description: 
  - Key: behavior:Remedy.CharacterControllers.LedgeGrab.LedgeGrabController
    Title: Ledge Grab Controller
    Summary: Hangs from a ledge in front of the character, and clambers up it on jump. Input comes from the Motion Context's Signals.
    Description: 
  - Key: behavior:Remedy.CharacterControllers.Stamina.StaminaController
    Title: Stamina Controller
    Summary: The Stamina Controller Behavior.
    Description: 
  - Key: behavior:Remedy.CharacterControllers.WallSlide.WallSlideController
    Title: Wall Slide Controller
    Summary: Slides down walls the character moves into, and jumps off them. Input comes from the Motion Context's Signals.
    Description: 
  - Key: behavior:Remedy.Damagables.DamageInstigator
    Title: Damage Instigator
    Summary: Deals damage, either to Damageables in a radius when Instigate is sent, or on contact depending on its Data.
    Description: 
  - Key: behavior:Remedy.Damagables.Damageable
    Title: Damageable
    Summary: "Health, damage and healing for an object. The methods act on the selected instance, e.g.\r target.GetSchematicBehavior<Damageable>()?.Damage(instigation), or take the instance explicitly."
    Description: 
  - Key: behavior:Remedy.Inventories.CollectableInventory
    Title: Collectable Inventory
    Summary: Items lying in the world, picked up by an Inventory on the same Inventory Layer.
    Description: 
  - Key: behavior:Remedy.Inventories.Inventory
    Title: Inventory
    Summary: "Holds Inventory Items for its object and picks up Collectable Inventories on its Inventory Layer.\r Its Data asset is copied per spawn, so instances never write into the shared asset."
    Description: 
  - Key: behavior:Remedy.LevelDesign.CheckpointAgent
    Title: Checkpoint Agent
    Summary: Moves its object's Box3D body to the position carried by the Respawn Signal (stopping it there).
    Description: 
  - Key: behavior:Remedy.LevelDesign.SpawnPoint
    Title: Spawn Point
    Summary: "A place the player can be spawned. Spawn acts on the selected instance, e.g.\r point.GetSchematicBehavior<SpawnPoint>().Spawn(player)."
    Description: 
  - Key: behavior:Remedy.LevelDesign.TriggerVolume
    Title: Trigger Volume
    Summary: Trigger Volumes are a base for any Volumes that would invoke Events related to the player's interactions with it.
    Description: 
  - Key: behavior:Remedy.ManifoldNetwork.Schematics.Brain
    Title: Brain
    Summary: "A learning brain for a Schematic Object, run by a Manifold Neuron Network. Its inputs and outputs are slots you\r define in the IO Dock; the graph feeds the inputs on On Think (Set Brain Input) and reads the\r decisions on On Decided (Get Brain Output). Teach it (Teach Brain Output), praise or punish it\r (Reward Brain), and it learns as it plays.\r\n\nShared: every instance of the object thinks with one brain (and learns together). Per Instance: each gets its own."
    Description: 
  - Key: behavior:Remedy.Materials.MaterialComunicator
    Title: Material Comunicator
    Summary: "Drives material properties from Signals: each entry of its Properties maps a Signal to a shader property.\r Uses the Renderer's shared material unless the Properties name one."
    Description: 
  - Key: behavior:Remedy.Splines.OnRailsRig
    Title: On Rails Rig
    Summary: "Star Fox-style on-rails movement. The object is a rig that travels along a spline (its Spline Agent) carrying a\r camera; the ship inside it moves freely on the plane in front of the camera, clamped so it never leaves the\r screen, banking and pitching as it goes. The camera drifts a little toward the ship, as in the games."
    Description: 
  - Key: behavior:Remedy.Splines.SplineAgent
    Title: Spline Agent
    Summary: "Moves its object along a Dreamteck spline at a set speed: the Schematic counterpart to Dreamteck's\r SplineFollower, with every follower in the game updated by one Behavior.\r Can jump to the closest point on another spline (branching paths), snap to its spline's closest point, and fire\r the spline's Dreamteck triggers as it passes them."
    Description: 
  - Key: behavior:Remedy.Splines.SplinePairAgent
    Title: Spline Pair Agent
    Summary: "Two points on a spline kept a set distance apart, like the front and back wheels of a cart or the two bogies of a\r train car. The object's Spline Agent moves the front point; the back point trails it. The object can sit between\r them facing from back to front, and Front/Back objects can be placed on each point."
    Description: 
  - Key: behavior:Remedy.Splines.SplineTracker
    Title: Spline Tracker
    Summary: "Keeps its object on the point of a spline closest to a target, like a camera dolly tracking the player or a\r guard pacing alongside them: the Schematic counterpart to Dreamteck's SplineProjector."
    Description: 
  - Key: behavior:Remedy.UI.UIComponent
    Title: UI Component
    Summary: "A UI element rendered on the UI layer at a depth set by its Layer. Extend it for specific UI elements and\r override Initiate And Subscribe Events/Un Subscribe Events for their setup."
    Description: 
  - Key: behavior:Remedy.UI.UISprite
    Title: UI Sprite
    Summary: "A textured quad on the UI layer. Create one in code with New.\r Its methods act on the selected instance, as returned by New or GetSchematicBehavior<UISprite>()."
    Description: 
  - Key: behavior:Remedy.Weapons.Projectiles.Projectile
    Title: Projectile
    Summary: The Projectile Behavior.
    Description: 
  - Key: behavior:Remedy.Weapons.Weapon
    Title: Weapon
    Summary: 'A Weapon prefab: held in the Sockets of a Weapon Holder, firing Projectiles from its Fire Modes'' Muzzles.'
    Description: 
  - Key: behavior:Remedy.Weapons.WeaponHolder
    Title: Weapon Holder
    Summary: "The WeaponHolder should be attached to a GameObject which is the child of a Character, Vehicle, or whatever, seperate from motion behaviour.\r It has a unique Collider (Trigger) that is used for interactions with Weapons that can be picked up"
    Description: 
  - Key: behavior:StateMachine
    Title: State Machine
    Summary: "Runs a State Machine Definition on its Schematic Object: enters the initial state, turns the object's\r Behaviors on and off as states change, fires transitions on Signals or when their conditions hold, and runs each\r active state's graph (On State Enter / Update / Exit, plus its Signal nodes).\r States nest: being in \"Grounded\" also means being in its parent \"Alive\", whose transitions (e.g. to \"Dead\") and\r Behavior settings apply too, unless the child overrides them."
    Description: 
  - Key: node:OnActiveSceneChanged
    Title: On Active Scene Changed
    Summary: 
    Description: 
  - Key: node:OnAfterFirstSceneLoaded
    Title: On After First Scene Loaded
    Summary: 
    Description: 
  - Key: node:OnAssembliesLoaded
    Title: On Assemblies Loaded
    Summary: 
    Description: 
  - Key: node:OnBeforeFirstSceneLoaded
    Title: On Before First Scene Loaded
    Summary: 
    Description: 
  - Key: node:OnBeforeSplashScreen
    Title: On Before Splash Screen
    Summary: 
    Description: 
  - Key: node:OnLevelExit
    Title: On Level Exit
    Summary: 'Out: LevelName.'
    Description: 
  - Key: node:OnLevelStart
    Title: On Level Start
    Summary: 'Out: LevelName.'
    Description: 
  - Key: node:OnRuntimeFixedUpdate
    Title: On Runtime Fixed Update
    Summary: 
    Description: 
  - Key: node:OnRuntimeLateUpdate
    Title: On Runtime Late Update
    Summary: 
    Description: 
  - Key: node:OnRuntimeUpdate
    Title: On Runtime Update
    Summary: 
    Description: 
  - Key: node:OnSceneLoaded
    Title: On Scene Loaded
    Summary: 
    Description: 
  - Key: node:OnSceneUnloaded
    Title: On Scene Unloaded
    Summary: 
    Description: 
  - Key: node:OnSignalReceivedNode
    Title: On Signal Received
    Summary: "Fires when its Signal is sent to the object running this graph, from a Schematic Behavior or another graph.\r Subscribed by the Schematic Object when it spawns, under its UID."
    Description: 
  - Key: node:OnStart
    Title: On Start
    Summary: 'Out: LevelName.'
    Description: 
  - Key: node:Remedy.ManifoldNetwork.Schematics.CopyBrainNode
    Title: Copy Brain
    Summary: 'Gives one brain''s weights to another (same Brain Definition layout). Shared brains change for everyone.

      In: From, To.'
    Description: 
  - Key: node:Remedy.ManifoldNetwork.Schematics.DirectionToNode
    Title: Direction To
    Summary: 'Where a target is from an object''s point of view: its local direction (x right, z forward) and distance.

      In: From, Target.

      Out: Local Direction, Values, Distance, Angle.'
    Description: 
  - Key: node:Remedy.ManifoldNetwork.Schematics.GetBrainOutputNode
    Title: Get Brain Output
    Summary: 'Reads one output slot. Use it on On Decided.

      In: Brain Of.

      Out: Value, Pressed, Choice, Option.'
    Description: 
  - Key: node:Remedy.ManifoldNetwork.Schematics.MakeValuesNode
    Title: Make Values
    Summary: 'Several numbers as one list, for a multi-value brain input.

      In: A, B, C, D, Count.

      Out: Values.'
    Description: 
  - Key: node:Remedy.ManifoldNetwork.Schematics.MixBrainsNode
    Title: Mix Brains
    Summary: "Crossbreeds two brains into a third: Blend averages the weights, Swap Parts takes whole parts (the master, each\r head, the translator) from one parent or the other, Per Weight flips a coin for each. Amount is how much\r comes from B.\nIn: A, B, Into, Amount."
    Description: 
  - Key: node:Remedy.ManifoldNetwork.Schematics.MutateBrainNode
    Title: Mutate Brain
    Summary: 'Adds a little random noise to a brain''s weights (Strength is the noise''s typical size).

      In: Strength, Brain Of.'
    Description: 
  - Key: node:Remedy.ManifoldNetwork.Schematics.NearestWithTagNode
    Title: Nearest With Tag
    Summary: 'The nearest object with a tag within range: it, its position, and how far.

      In: From, Tag, Range.

      Out: Found, Object, Position, Distance.'
    Description: 
  - Key: node:Remedy.ManifoldNetwork.Schematics.RayFanNode
    Title: Ray Fan
    Summary: 'A fan of rays from an object (Box3D physics): each ray''s hit distance, 0 (touching) to 1 (nothing within range).

      In: From, Rays, Spread, Range, Height, Layers.

      Out: Distances, Closest.'
    Description: 
  - Key: node:Remedy.ManifoldNetwork.Schematics.ResetBrainMemoryNode
    Title: Reset Brain Memory
    Summary: 'Forgets the past: the brain''s memory (its heads) back at rest, for this instance.

      In: Brain Of.'
    Description: 
  - Key: node:Remedy.ManifoldNetwork.Schematics.RewardBrainNode
    Title: Reward Brain
    Summary: "Praise (positive) or punish (negative) the brain. The reward credits its recent decisions, most of all the\r latest ones, fading by the definition's Credit Half-Life.\nIn: Reward, Brain Of."
    Description: 
  - Key: node:Remedy.ManifoldNetwork.Schematics.SetBrainInputNode
    Title: Set Brain Input
    Summary: 'Feeds one input slot. Use it on On Think. A slot of Size n takes the Values list (or Value for one).

      In: Value, Values, Brain Of.'
    Description: 
  - Key: node:Remedy.ManifoldNetwork.Schematics.TeachBrainOutputNode
    Title: Teach Brain Output
    Summary: "\"The right answer was ...\": teaches an output slot this tick (an axis value, a button as Pressed, a choice's\r option index). E.g. wire the player's own input here so the bot learns by watching.\nIn: Value, Pressed, Choice, Brain Of."
    Description: 
  - Key: node:Remedy.Schematics.BehaviorReferenceNode
    Title: Behavior
    Summary: "A reference to one of the object's Behaviors, pinned out: every Variable as an output, its Enabled state,\r and optionally one of its public methods to call (with a pin per parameter and one for the result).\r Created by dragging a Behavior from the IO Dock. Reflection is done once per Behavior type and cached."
    Description: 
  - Key: node:Remedy.Schematics.BroadcastMethodInvocation
    Title: Broadcast Method Invocation
    Summary: 'In: Target, Name, Arguments.'
    Description: 
  - Key: node:Remedy.Schematics.CallFunction
    Title: Call Function
    Summary: 'In: FunctionParameters.'
    Description: 
  - Key: node:Remedy.Schematics.CastToFloat
    Title: Cast To Float
    Summary: 'In: Value.

      Out: Casted.'
    Description: 
  - Key: node:Remedy.Schematics.CastToGameObject
    Title: Cast To Game Object
    Summary: 'In: Value.

      Out: Casted.'
    Description: 
  - Key: node:Remedy.Schematics.CastToMonoBehaviour
    Title: Cast To Mono Behaviour
    Summary: 'In: Value.

      Out: Casted.'
    Description: 
  - Key: node:Remedy.Schematics.CastToTransform
    Title: Cast To Transform
    Summary: 'In: Value.

      Out: Position, EulerAngles, Casted.'
    Description: 
  - Key: node:Remedy.Schematics.CompaCastrison
    Title: Compa Castrison
    Summary: "In: First Value, Second Value.\nOut: \u25B6."
    Description: 
  - Key: node:Remedy.Schematics.CreateList
    Title: Create List
    Summary: 'In: Items.

      Out:  .'
    Description: 
  - Key: node:Remedy.Schematics.FindGameObjectsWithTag
    Title: Find Game Objects With Tag
    Summary: 'Out: Objects.'
    Description: 
  - Key: node:Remedy.Schematics.ForEach
    Title: For Each
    Summary: 'In: Items.

      Out: Index, This.'
    Description: 
  - Key: node:Remedy.Schematics.GetBehaviorVariableNode
    Title: Get Variable
    Summary: Reads a Behavior Variable of the object running the graph. Created by dragging a Variable from the IO Dock.
    Description: 
  - Key: node:Remedy.Schematics.GetChild
    Title: Get Child
    Summary: 'Out: Child.'
    Description: 
  - Key: node:Remedy.Schematics.HasColliderForward
    Title: Has Collider Forward
    Summary: "True when a sphere cast from the object along its forward axis hits something (with the given tag, if set)\r within the distance. Uses Box3D; moved here from Schematics Core, so existing graphs keep it.\nIn: Object, Other Tag, Distance, Radius.\nOut: \u25B6, Other GameObject."
    Description: 
  - Key: node:Remedy.Schematics.If
    Title: If
    Summary: 'In: Condition.'
    Description: 
  - Key: node:Remedy.Schematics.Instantiate
    Title: Instantiate
    Summary: 'In: Position, Rotation, Prefab.

      Out: Instanced Object.'
    Description: 
  - Key: node:Remedy.Schematics.IsNull
    Title: Is Null
    Summary: "In: Value.\nOut: \u25B6."
    Description: 
  - Key: node:Remedy.Schematics.ListCount
    Title: List Count
    Summary: 'In: List.

      Out: Count.'
    Description: 
  - Key: node:Remedy.Schematics.Log
    Title: Log
    Summary: 
    Description: 
  - Key: node:Remedy.Schematics.OnCollisionEnter
    Title: On Collision Enter
    Summary: 'Out: OtherCollider, Impulse, RelativeVelocity, OtherRigidbody, OtherArticulationBody, OtherTransform, OtherGameObject.'
    Description: 
  - Key: node:Remedy.Schematics.OnCollisionExit
    Title: On Collision Exit
    Summary: 'Out: OtherCollider, Impulse, RelativeVelocity, OtherRigidbody, OtherArticulationBody, OtherTransform, OtherGameObject.'
    Description: 
  - Key: node:Remedy.Schematics.OnCreate
    Title: On Create
    Summary: 
    Description: 
  - Key: node:Remedy.Schematics.OnDestroy
    Title: On Destroy
    Summary: 
    Description: 
  - Key: node:Remedy.Schematics.OnFunction
    Title: On Function
    Summary: 'Out: FunctionParameters.'
    Description: 
  - Key: node:Remedy.Schematics.OnStateEnter
    Title: On State Enter
    Summary: 'In a state''s graph: runs when the state is entered.'
    Description: 
  - Key: node:Remedy.Schematics.OnStateExit
    Title: On State Exit
    Summary: 'In a state''s graph: runs when the state is left.'
    Description: 
  - Key: node:Remedy.Schematics.OnStateUpdate
    Title: On State Update
    Summary: 'In a state''s graph: runs every frame while the state (or one of its children) is active.'
    Description: 
  - Key: node:Remedy.Schematics.OnTriggerEnter
    Title: On Trigger Enter
    Summary: 'Out: collider.'
    Description: 
  - Key: node:Remedy.Schematics.OnTriggerExit
    Title: On Trigger Exit
    Summary: 'Out: collider.'
    Description: 
  - Key: node:Remedy.Schematics.OnUpdate
    Title: On Update
    Summary: 
    Description: 
  - Key: node:Remedy.Schematics.PickFromListWithTag
    Title: Pick From List With Tag
    Summary: 'In: List, Tag.

      Out: Objects With Tag.'
    Description: 
  - Key: node:Remedy.Schematics.PickNthItem
    Title: Pick Nth Item
    Summary: 'In: List, Index.

      Out: Item.'
    Description: 
  - Key: node:Remedy.Schematics.PrefabObjectNode
    Title: Prefab Object
    Summary: "A GameObject from the Schematic Object's hierarchy, found on the spawned object running the graph.\r Created by dragging a GameObject from the IO Dock's prefab hierarchy.\nOut: Object, Transform."
    Description: 
  - Key: node:Remedy.Schematics.RandInt
    Title: Rand Int
    Summary: 'In: LowerBound, UpperBound.

      Out: Value.'
    Description: 
  - Key: node:Remedy.Schematics.SetBehaviorVariableNode
    Title: Set Variable
    Summary: Writes a Behavior Variable of the object running the graph. Created by dragging a Variable from the IO Dock.
    Description: 
  - Key: node:Remedy.Schematics.SetPosition
    Title: Set Position
    Summary: 'In: Target, Position.'
    Description: 
  - Key: node:Remedy.Schematics.This
    Title: This
    Summary: 'Out:  .'
    Description: 
  - Key: node:Remedy.Schematics.Wait
    Title: Wait
    Summary: 'In: Wait Time.'
    Description: 
  - Key: node:Remedy.Splines.ClosestPointOnSplineNode
    Title: Closest Point On Spline
    Summary: 'The point on a spline closest to a position.

      In: Spline, Position.

      Out: Point, Percent, Distance, Forward.'
    Description: 
  - Key: node:Remedy.Splines.EvaluateSplineNode
    Title: Evaluate Spline
    Summary: 'The point at a 0-1 position along a spline.

      In: Spline, Percent.

      Out: Point, Forward, Up.'
    Description: 
  - Key: node:Remedy.Splines.JumpToSplineNode
    Title: Jump To Spline
    Summary: "Moves an object's Spline Agent onto another spline at its closest point (branching paths). With no spline\r connected, it jumps to the nearest other spline in the scene.\nIn: Agent, Spline."
    Description: 
  - Key: node:SendSignalNode
    Title: Send a Signal
    Summary: "Sends its Signal to the object running this graph, where Schematic Behaviors and other graphs hear it.\r Has an input pin per Signal parameter (added by the editor when the Signal is dropped in)."
    Description: 
  - Key: signal:CharacterMotionContext.JumpInput
    Title: Jump Input (Character Motion Context)
    Summary: A Signal of Character Motion Context.
    Description: 
  - Key: signal:CharacterMotionContext.MoveInput
    Title: Move Input (Character Motion Context)
    Summary: A Signal of Character Motion Context.
    Description: 
  - Key: signal:CharacterMotionContext.OnFall
    Title: On Fall (Character Motion Context)
    Summary: A Signal of Character Motion Context.
    Description: 
  - Key: signal:CharacterMotionContext.OnJump
    Title: On Jump (Character Motion Context)
    Summary: A Signal of Character Motion Context.
    Description: 
  - Key: signal:CharacterMotionContext.OnMoveOnGround
    Title: On Move On Ground (Character Motion Context)
    Summary: A Signal of Character Motion Context.
    Description: 
  - Key: signal:CharacterMotionContext.SetDirectionOfGravity
    Title: Set Direction Of Gravity (Character Motion Context)
    Summary: A Signal of Character Motion Context.
    Description: 
  - Key: signal:CharacterMotionContext.StaminaUpdated
    Title: Stamina Updated (Character Motion Context)
    Summary: A Signal of Character Motion Context.
    Description: 
  - Key: signal:CharacterRaycastContext.CheckForWall
    Title: Check For Wall (Character Raycast Context)
    Summary: Casts for a wall in the given direction.
    Description: 
  - Key: signal:CharacterRaycastContext.OnHitWall
    Title: On Hit Wall (Character Raycast Context)
    Summary: Sent when a wall cast hits, passing the point that was hit.
    Description: 
  - Key: signal:PhysicsBasedCharacterController.MoveToPosition
    Title: Move To Position (Physics Based Character Controller)
    Summary: A Signal of Physics Based Character Controller.
    Description: 
  - Key: signal:Remedy.Audio.SoundCue.Event
    Title: Event (Sound Cue)
    Summary: Plays this Sound Cue, whatever the Signal carries.
    Description: 
  - Key: signal:Remedy.Audio.SoundCue.StopEvent
    Title: Stop Event (Sound Cue)
    Summary: A Signal of Sound Cue.
    Description: 
  - Key: signal:Remedy.Cameras.ShoulderCamera.ActualLookDirection
    Title: Actual Look Direction (Shoulder Camera)
    Summary: A Signal of Shoulder Camera.
    Description: 
  - Key: signal:Remedy.Cameras.ShoulderCamera.AimPosition
    Title: Aim Position (Shoulder Camera)
    Summary: A Signal of Shoulder Camera.
    Description: 
  - Key: signal:Remedy.Cameras.ShoulderCamera.GoalLookDirection
    Title: Goal Look Direction (Shoulder Camera)
    Summary: A Signal of Shoulder Camera.
    Description: 
  - Key: signal:Remedy.Cameras.ThirdPersonCamera.AimPosition
    Title: Aim Position (Third Person Camera)
    Summary: A Signal of Third Person Camera.
    Description: 
  - Key: signal:Remedy.CharacterControllers.CharacterControllerRig.InputAim
    Title: Input Aim (Character Controller Rig)
    Summary: Vector3 Input for the Aim Direction, should be passed from the Camera Manager.
    Description: 
  - Key: signal:Remedy.CharacterControllers.CharacterControllerRig.InputOrientToAim
    Title: Input Orient To Aim (Character Controller Rig)
    Summary: Boolean Inputs that determine whether to Orient toward the Aim Direction.
    Description: 
  - Key: signal:Remedy.CharacterControllers.CharacterControllerRig.IsHovering
    Title: Is Hovering (Character Controller Rig)
    Summary: A Signal of Character Controller Rig.
    Description: 
  - Key: signal:Remedy.CharacterControllers.CharacterControllerRig.IsLedgeGrabbing
    Title: Is Ledge Grabbing (Character Controller Rig)
    Summary: A Signal of Character Controller Rig.
    Description: 
  - Key: signal:Remedy.CharacterControllers.CharacterControllerRig.IsOnGround
    Title: Is On Ground (Character Controller Rig)
    Summary: A Signal of Character Controller Rig.
    Description: 
  - Key: signal:Remedy.CharacterControllers.CharacterControllerRig.IsStrafing
    Title: Is Strafing (Character Controller Rig)
    Summary: A Signal of Character Controller Rig.
    Description: 
  - Key: signal:Remedy.CharacterControllers.CharacterControllerRig.IsWallSliding
    Title: Is Wall Sliding (Character Controller Rig)
    Summary: A Signal of Character Controller Rig.
    Description: 
  - Key: signal:Remedy.CharacterControllers.CharacterControllerRig.OnGroundCast
    Title: On Ground Cast (Character Controller Rig)
    Summary: A Signal of Character Controller Rig.
    Description: 
  - Key: signal:Remedy.CharacterControllers.CharacterControllerRig.OnGroundCastHit
    Title: On Ground Cast Hit (Character Controller Rig)
    Summary: A Signal of Character Controller Rig.
    Description: 
  - Key: signal:Remedy.CharacterControllers.CharacterControllerRig.VerticalVelocity
    Title: Vertical Velocity (Character Controller Rig)
    Summary: A Signal of Character Controller Rig.
    Description: 
  - Key: signal:Remedy.CharacterControllers.Gadgets.Pusher.OnHit
    Title: On Hit (Pusher)
    Summary: Invoked when a Rigidbody Collides with this.
    Description: 
  - Key: signal:Remedy.CharacterControllers.LedgeGrab.LedgeGrabController.OnClamber
    Title: On Clamber (Ledge Grab Controller)
    Summary: A Signal of Ledge Grab Controller.
    Description: 
  - Key: signal:Remedy.CharacterControllers.LedgeGrab.LedgeGrabController.OnLedgeGrabExitted
    Title: On Ledge Grab Exitted (Ledge Grab Controller)
    Summary: A Signal of Ledge Grab Controller.
    Description: 
  - Key: signal:Remedy.CharacterControllers.Stamina.StaminaController.OnStaminaChanged
    Title: On Stamina Changed (Stamina Controller)
    Summary: Passes the current amount of stamina
    Description: 
