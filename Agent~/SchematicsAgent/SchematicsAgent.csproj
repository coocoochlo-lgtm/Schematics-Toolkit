<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    The Schematics assistant's local server: the language model (llama.cpp through LLamaSharp), speech to text
    (whisper.cpp through Whisper.net) and text to speech (Kokoro through sherpa-onnx), with RE:Dox reading and writing
    the JSON exchanged with the Unity editor. Started by the editor (Tools > Remedy > Schematics > Assistant).
    Build with GPU acceleration: dotnet build -p:LlmBackend=Cuda12 (or Vulkan).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591;CS8600;CS8602;CS8604</NoWarn>
    <LlmBackend Condition="'$(LlmBackend)' == ''">Cpu</LlmBackend>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" Condition="'$(LlmBackend)' == 'Cpu'" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.27.0" Condition="'$(LlmBackend)' == 'Cuda12'" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" Condition="'$(LlmBackend)' == 'Vulkan'" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
  </ItemGroup>

  <!-- RE:Dox (vendored in Dependencies), compiled into the server: Unity's compiler can't build it. -->
  <ItemGroup>
    <Compile Include="../../Dependencies/REDox-1.0.1/src/REDox/**/*.cs" Link="REDox/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
